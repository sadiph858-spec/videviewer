<?xml version="1.0" encoding="utf-8"?>
<!-- Vinyl disc placeholder for the Audio Player album art area -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer dark ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2A0060" />
        </shape>
    </item>

    <!-- Mid ring — slightly lighter -->
    <item
        android:top="16dp"
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#1A0040" />
        </shape>
    </item>

    <!-- Inner hole -->
    <item
        android:top="72dp"
        android:bottom="72dp"
        android:left="72dp"
        android:right="72dp">
        <shape android:shape="oval">
            <solid android:color="#0A0015" />
        </shape>
    </item>

</layer-list>
