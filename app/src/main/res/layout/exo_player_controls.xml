<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom ExoPlayer controller — YouTube-inspired, VidViewer purple style.
  Shows/hides on tap. Required IDs: exo_progress, exo_position, exo_duration,
  exo_play_pause, exo_rew, exo_ffwd, exo_shuffle, exo_repeat_toggle.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Center: rewind | play/pause | forward ──────────── -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginTop="52dp">

        <!-- Rewind -10s -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="40dp">

            <ImageButton
                android:id="@id/exo_rew"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@android:drawable/ic_media_rew"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_play_pause_button"
                android:padding="14dp"
                android:contentDescription="Rewind 10 seconds" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10s"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Play / Pause — large purple circle -->
        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#FFFFFF"
            android:background="@drawable/bg_play_button_circle"
            android:padding="18dp"
            android:contentDescription="Play or Pause" />

        <!-- Fast-forward +10s -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="40dp">

            <ImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@android:drawable/ic_media_ff"
                android:tint="#FFFFFF"
                android:background="@drawable/bg_play_pause_button"
                android:padding="14dp"
                android:contentDescription="Forward 10 seconds" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10s"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Bottom: gradient + seek + timestamps + extras ──── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_player_gradient_bottom"
        android:paddingTop="48dp"
        android:paddingBottom="14dp"
        android:paddingHorizontal="16dp">

        <!-- Purple-tinted seek bar -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginBottom="4dp" />

        <!-- Timestamps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BBFFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Extra controls: shuffle on left, repeat on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@id/exo_shuffle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#BBFFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Shuffle" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@id/exo_repeat_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="#BBFFFFFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Repeat" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
