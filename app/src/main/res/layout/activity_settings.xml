<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Theme Section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/theme_settings" android:textSize="13sp"
                android:textColor="?attr/colorPrimary" android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" app:cardCornerRadius="12dp" app:cardElevation="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_light" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/theme_light" android:layout_marginEnd="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_dark" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/theme_dark" android:layout_marginStart="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_system" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/theme_system" android:layout_marginEnd="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_theme_dynamic" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Dynamic" android:layout_marginStart="4dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Language Section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/language_settings" android:textSize="13sp"
                android:textColor="?attr/colorPrimary" android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" app:cardCornerRadius="12dp" app:cardElevation="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_english" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/lang_english" android:layout_marginEnd="8dp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lang_bangla" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/lang_bangla"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Playback Section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/playback_settings" android:textSize="13sp"
                android:textColor="?attr/colorPrimary" android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" app:cardCornerRadius="12dp" app:cardElevation="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/resume_playback"
                            android:textSize="15sp" android:textColor="?attr/colorOnSurface" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_resume_playback"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0.5dp"
                        android:background="?attr/colorOutline" android:layout_marginHorizontal="16dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingHorizontal="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="@string/auto_play"
                            android:textSize="15sp" android:textColor="?attr/colorOnSurface" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_auto_play"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ads Section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ad_settings" android:textSize="13sp"
                android:textColor="?attr/colorPrimary" android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" app:cardCornerRadius="12dp" app:cardElevation="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/ads_enabled"
                        android:textSize="15sp" android:textColor="?attr/colorOnSurface" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_ads_enabled"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Storage Section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/storage_settings" android:textSize="13sp"
                android:textColor="?attr/colorPrimary" android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" app:cardCornerRadius="12dp" app:cardElevation="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_vault_lock"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Vault Lock Settings" android:layout_marginBottom="12dp"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_history"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/clear_history"
                        app:backgroundTint="@color/md_theme_error_container"
                        android:textColor="@color/md_theme_on_error_container" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
