<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_dark"
    android:paddingBottom="1dp">

    <!-- Divider line at bottom -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_thumbnail" />

    <!-- Thumbnail (120dp wide) -->
    <ImageView
        android:id="@+id/iv_thumbnail"
        android:layout_width="120dp"
        android:layout_height="75dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_video_placeholder"
        android:background="@color/bg_surface_variant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Duration badge overlaid on thumbnail bottom-right -->
    <TextView
        android:id="@+id/tv_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="9sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_duration_badge"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="3dp"
        app:layout_constraintEnd_toEndOf="@id/iv_thumbnail"
        app:layout_constraintBottom_toBottomOf="@id/iv_thumbnail" />

    <!-- HD Badge top-left of thumbnail -->
    <TextView
        android:id="@+id/badge_hd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HD"
        android:textSize="8sp"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-bold"
        android:background="@drawable/bg_hd_badge"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="3dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/iv_thumbnail"
        app:layout_constraintTop_toTopOf="@id/iv_thumbnail" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Video Title"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_thumbnail"
        app:layout_constraintEnd_toStartOf="@id/btn_more" />

    <!-- Folder name -->
    <TextView
        android:id="@+id/tv_folder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Folder"
        android:textSize="11sp"
        android:textColor="@color/text_tertiary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toEndOf="@id/iv_thumbnail"
        app:layout_constraintEnd_toStartOf="@id/btn_more" />

    <!-- Bottom row: size · format badge -->
    <TextView
        android:id="@+id/tv_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 MB"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_thumbnail" />

    <!-- Format badge (MP4, MKV, etc.) -->
    <TextView
        android:id="@+id/tv_format"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MP4"
        android:textSize="9sp"
        android:textColor="#CCFFFFFF"
        android:fontFamily="sans-serif-bold"
        android:background="@drawable/bg_format_badge"
        android:paddingHorizontal="5dp"
        android:paddingVertical="2dp"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_size" />

    <!-- Favorite star icon -->
    <ImageView
        android:id="@+id/iv_favorite"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@android:drawable/btn_star_big_on"
        android:tint="@color/accent_primary"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_thumbnail" />

    <!-- Three-dot menu button -->
    <ImageButton
        android:id="@+id/btn_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="@color/text_secondary"
        android:layout_marginEnd="2dp"
        android:layout_marginTop="4dp"
        android:contentDescription="More options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
