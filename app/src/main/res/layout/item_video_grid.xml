<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Thumbnail -->
        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="0dp"
            android:layout_height="@dimen/thumbnail_height_grid"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_video_placeholder"
            android:background="?attr/colorSurfaceVariant"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Duration badge (bottom-right of thumbnail) -->
        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_duration_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintEnd_toEndOf="@id/iv_thumbnail"
            app:layout_constraintBottom_toBottomOf="@id/iv_thumbnail" />

        <!-- HD Badge -->
        <TextView
            android:id="@+id/badge_hd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HD"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_hd_badge"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/iv_thumbnail"
            app:layout_constraintTop_toTopOf="@id/iv_thumbnail" />

        <!-- Favorite icon -->
        <ImageView
            android:id="@+id/iv_favorite"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/btn_star_big_on"
            android:tint="@color/md_theme_primary"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/iv_thumbnail"
            app:layout_constraintTop_toTopOf="@id/iv_thumbnail" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Video Title"
            android:textSize="@dimen/text_subtitle"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toBottomOf="@id/iv_thumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Size -->
        <TextView
            android:id="@+id/tv_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0 MB"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingHorizontal="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
