<?xml version="1.0" encoding="utf-8"?>
<!-- bottom_sheet_video_options.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Video title -->
    <TextView
        android:id="@+id/tv_video_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Video Title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp" />

    <!-- Details -->
    <LinearLayout
        android:id="@+id/option_details"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:tint="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/video_details" android:textSize="15sp"
            android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Share -->
    <LinearLayout
        android:id="@+id/option_share"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_share"
            android:tint="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/share_video" android:textSize="15sp"
            android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Download -->
    <LinearLayout
        android:id="@+id/option_download"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/stat_sys_download"
            android:tint="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Download" android:textSize="15sp"
            android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Favorite -->
    <LinearLayout
        android:id="@+id/option_favorite"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/added_to_favorites" android:textSize="15sp"
            android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Add to Playlist -->
    <LinearLayout
        android:id="@+id/option_playlist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_add"
            android:tint="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/playlists" android:textSize="15sp"
            android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Move to Vault -->
    <LinearLayout
        android:id="@+id/option_vault"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="@color/vault_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/private_vault" android:textSize="15sp"
            android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Rename -->
    <LinearLayout
        android:id="@+id/option_rename"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="?attr/colorOnSurface" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/rename_video" android:textSize="15sp"
            android:textColor="?attr/colorOnSurface" android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Delete -->
    <LinearLayout
        android:id="@+id/option_delete"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@color/md_theme_error" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/delete_video" android:textSize="15sp"
            android:textColor="@color/md_theme_error" android:layout_marginStart="16dp" />
    </LinearLayout>

</LinearLayout>
