<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_surface"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playback_speed"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/chip_speed_025" style="@style/SpeedChip" android:text="0.25x" />
        <TextView android:id="@+id/chip_speed_05"  style="@style/SpeedChip" android:text="0.5x" />
        <TextView android:id="@+id/chip_speed_075" style="@style/SpeedChip" android:text="0.75x" />
        <TextView android:id="@+id/chip_speed_1"   style="@style/SpeedChip" android:text="1x" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView android:id="@+id/chip_speed_125" style="@style/SpeedChip" android:text="1.25x" />
        <TextView android:id="@+id/chip_speed_15"  style="@style/SpeedChip" android:text="1.5x" />
        <TextView android:id="@+id/chip_speed_175" style="@style/SpeedChip" android:text="1.75x" />
        <TextView android:id="@+id/chip_speed_2"   style="@style/SpeedChip" android:text="2x" />
    </LinearLayout>

</LinearLayout>
