<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only backup non-sensitive settings -->
        <include domain="sharedpref" path="videviewer_prefs.xml" />
        <exclude domain="database" path="videviewer_db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="videviewer_prefs.xml" />
        <exclude domain="database" path="videviewer_db" />
    </device-transfer>
</data-extraction-rules>
