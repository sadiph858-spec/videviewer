<?xml version="1.0" encoding="utf-8"?>
  <resources xmlns:tools="http://schemas.android.com/tools">
      <style name="Theme.VidViewer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
          <item name="colorPrimary">@color/accent</item>
          <item name="colorPrimaryVariant">@color/accent_dark</item>
          <item name="colorOnPrimary">@color/white</item>
          <item name="colorSecondary">@color/accent</item>
          <item name="colorOnSecondary">@color/white</item>
          <item name="android:colorBackground">@color/bg_dark</item>
          <item name="colorSurface">@color/bg_surface</item>
          <item name="colorOnSurface">@color/white</item>
          <item name="colorError">@color/error</item>
          <item name="android:windowBackground">@color/bg_dark</item>
          <item name="android:statusBarColor">@color/bg_dark</item>
          <item name="android:navigationBarColor">@color/bg_nav</item>
          <item name="android:textColorPrimary">@color/text_primary</item>
          <item name="android:textColorSecondary">@color/text_secondary</item>
      </style>

      <style name="Theme.VidViewer.Splash" parent="Theme.VidViewer">
          <item name="android:windowFullscreen">true</item>
      </style>

      <style name="Theme.VidViewer.Player" parent="Theme.MaterialComponents.NoActionBar">
          <item name="android:windowBackground">@color/black</item>
          <item name="android:statusBarColor">@color/black</item>
          <item name="android:navigationBarColor">@color/black</item>
          <item name="android:windowFullscreen">true</item>
          <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
      </style>

      <style name="DarkDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
          <item name="colorSurface">@color/bg_card</item>
          <item name="colorOnSurface">@color/white</item>
          <item name="colorPrimary">@color/accent</item>
          <item name="android:textColorPrimary">@color/white</item>
          <item name="android:textColorSecondary">@color/text_secondary</item>
          <item name="android:windowBackground">@color/bg_card</item>
      </style>
  </resources>